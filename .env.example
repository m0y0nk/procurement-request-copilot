# Local mock service
VENDOR_RISK_BASE_URL=http://127.0.0.1:8001
PROCUREMENT_API_BASE_URL=http://127.0.0.1:8000
PROCUREMENT_ANALYSIS_TIMEOUT_SECONDS=600

# LLM wrapper (live mode needs a key; replay mode does not)
LLM_MODE=replay
LLM_PROVIDER=openai
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_REPLAY_PATH=eval/replay/responses.json
LLM_USAGE_PATH=.cache/llm_usage.json
LLM_MAX_TOKENS=1200
LLM_MAX_CALLS_PER_RUN=200
LLM_MAX_CALLS_PER_DAY=1000
LLM_MAX_TOKENS_PER_RUN=200000
LLM_MAX_TOKENS_PER_DAY=200000
LLM_REQUESTS_PER_MINUTE=30
LLM_TOKENS_PER_MINUTE=8000
LLM_MAX_WAIT_SECONDS=90
LLM_MIN_INTERVAL_SECONDS=20.1
LLM_REASONING_EFFORT=low
LLM_NO_CACHE=0
EVAL_CASE_DELAY_SECONDS=3
LLM_REPEAT_SAMPLE=8
