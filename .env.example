# Local mock service
VENDOR_RISK_BASE_URL=http://127.0.0.1:8001
PROCUREMENT_API_BASE_URL=http://127.0.0.1:8000

# LLM wrapper (live mode needs a key; replay mode does not)
LLM_MODE=replay
LLM_PROVIDER=openai
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_REPLAY_PATH=eval/replay/responses.json
LLM_USAGE_PATH=.cache/llm_usage.json
LLM_MAX_TOKENS=1200
LLM_MAX_CALLS_PER_RUN=200
LLM_MAX_TOKENS_PER_RUN=150000
LLM_MAX_TOKENS_PER_DAY=150000
LLM_MAX_WAIT_SECONDS=90
LLM_MIN_INTERVAL_SECONDS=2.5
LLM_NO_CACHE=0
EVAL_CASE_DELAY_SECONDS=3
LLM_REPEAT_SAMPLE=8
